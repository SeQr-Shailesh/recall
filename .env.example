# SeQr Recall environment variable template.
# Copy values into user secrets, IIS environment variables, or a local untracked file.
# Never commit real secrets.

ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__DefaultConnection=Server=localhost;Database=SeQrRecall;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True

Jwt__Issuer=SeQrRecall
Jwt__Audience=SeQrRecall.Mobile
Jwt__Secret=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

Speech__Provider=Mock
Speech__ApiKey=
Speech__BaseUrl=https://api.sarvam.ai
Speech__Model=saaras:v3

AI__Provider=Mock
AI__OpenAI__ApiKey=
AI__OpenAI__BaseUrl=https://api.openai.com/v1
AI__OpenAI__Model=gpt-4o-mini
AI__Gemini__ApiKey=
AI__Gemini__BaseUrl=https://generativelanguage.googleapis.com/v1beta
AI__Gemini__Model=gemini-3.5-flash
AI__Qwen__ApiKey=
AI__Qwen__BaseUrl=http://127.0.0.1:8000/v1
AI__Qwen__Model=qwen3-4b
AI__Qwen__TimeoutSeconds=120

Storage__Provider=Local
Storage__RootPath=

Uploads__AudioMaxBytes=26214400
Uploads__PhotoMaxBytes=5242880

RateLimiting__OtpSendPermitLimit=5
RateLimiting__OtpVerifyPermitLimit=10
RateLimiting__OtpWindowSeconds=60
RateLimiting__UploadPermitLimit=20
RateLimiting__UploadWindowSeconds=60

# Mobile (React Native) — used from Phase 4 onward.
API_BASE_URL=http://10.0.2.2:5080
